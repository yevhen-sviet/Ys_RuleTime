<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ys\RuleTime\Api\TimeRepositoryInterface"
        type="Ys\RuleTime\Model\TimeRepository"/>

    <preference for="Ys\RuleTime\Api\Data\TimeInterface"
            type="Ys\RuleTime\Model\Time"/>
    
    <type name="Magento\SalesRule\Model\ResourceModel\Rule\Collection">
        <plugin name="ys_ruletime_sql_filter"
            type="Ys\RuleTime\Plugin\RuleCollectionAddTimeFilter"/>
    </type>

    <type name="Magento\SalesRule\Model\Rule">
        <plugin name="ys_ruletime_is_active"
            type="Ys\RuleTime\Plugin\RuleIsActiveTime"/>
    </type>

    <type name="Magento\SalesRule\Model\ResourceModel\Rule">
        <plugin name="ys_ruletime_after_resource_rule_save_commit"
            type="Ys\RuleTime\Plugin\ResourceModel\Rule\AfterSaveCommit"
            sortOrder="100"/>
    </type>
</config>