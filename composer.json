{
  "name": "ys/module-ruletime",
  "description": "Magento 2 extension that adds exact From/To time support to Cart Price Rules.",
  "type": "magento2-module",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Yevhen Sviet",
      "email": "ysviet@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4",
    "magento/framework": "103.*",
    "magento/module-sales-rule": "103.*"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Ys\\RuleTime\\": ""
    }
  },
  "extra": {
    "map": [
      [
        "*",
        "Ys/RuleTime"
      ]
    ]
  },
  "keywords": [
    "magento2",
    "salesrule",
    "cart-price-rules",
    "promotion",
    "time-window",
    "ruletime"
  ],
  "support": {
    "email": "ysviet@gmail.com",
    "issues": "https://github.com/ysviet/magento2-ruletime/issues",
    "source": "https://github.com/ysviet/magento2-ruletime"
  }
}